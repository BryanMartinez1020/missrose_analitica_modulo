<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_missrose_analitica_modulo_list" model="ir.ui.view">
            <field name="name">miss.rose.analytics.list</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <list string="Clientes Miss Rose" create="0" edit="0" delete="0">
                    <field name="mr_currency_id" column_invisible="True"/>
                    <field name="name" string="Cliente" />
                    <field name="mobile" string="Celular" optional="show" />
                    <field name="email" string="Correo" optional="hide" />
                    <field name="city" string="Ciudad / Depto." optional="show" />
                    <field name="state_id" string="Departamento" optional="hide" />
                    <field name="mr_last_purchase_date" string="Fecha Últ. Compra" />
                    <field name="mr_last_purchase_amount" string="Monto Últ. Compra" />
                    <field name="mr_total_purchase" string="Total Histórico" />
                    <field name="mr_purchase_count" string="Cant. Facturas" />
                    <field name="mr_average_ticket" string="Gasto Promedio" />
                    <button name="action_view_mr_invoices" type="object" string="Facturas" icon="fa-file-text-o"/>
                    <field name="mr_days_since_purchase" string="Días sin Comprar" />
                    <field name="mr_next_purchase_prob" string="Vuelve a comprar el" />
                </list>
            </field>
        </record>

        <record id="view_missrose_analitica_modulo_search" model="ir.ui.view">
            <field name="name">miss.rose.analytics.search</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <search string="Filtros Miss Rose">
                    <filter string="Activos (Verde)" name="filter_active_mr" domain="[('mr_days_since_purchase', '&lt;=', 30)]"/>
                    <filter string="Medio Activos (Naranja)" name="filter_semi_active_mr" domain="[('mr_days_since_purchase', '&gt;', 30), ('mr_days_since_purchase', '&lt;=', 90)]"/>
                    <filter string="Inactivos (Rojo)" name="filter_inactive_mr" domain="[('mr_days_since_purchase', '&gt;', 90)]"/>
                    <!-- Filtros por Probabilidad -->
                    <separator/>
                    <filter string="🎯 Alta Probabilidad (>= 80%)" name="prob_high" domain="[('mr_forecast_probability', '&gt;=', 0.80)]"/>
                    <filter string="🎯 Probabilidad Media (40% - 79%)" name="prob_medium" domain="[('mr_forecast_probability', '&gt;=', 0.40), ('mr_forecast_probability', '&lt;', 0.80)]"/>
                    <filter string="🎯 Baja Probabilidad (&lt; 40%)" name="prob_low" domain="[('mr_forecast_probability', '&lt;', 0.40)]"/>

                    <!-- Filtros por Departamentos de El Salvador -->
                    <separator/>
                    <filter string="📍 Ahuachapán" name="dept_ahuachapan" domain="[('city', 'ilike', 'Ahuachapán')]"/>
                    <filter string="📍 Cabañas" name="dept_cabanas" domain="[('city', 'ilike', 'Cabañas')]"/>
                    <filter string="📍 Chalatenango" name="dept_chalatenango" domain="[('city', 'ilike', 'Chalatenango')]"/>
                    <filter string="📍 Cuscatlán" name="dept_cuscatlan" domain="[('city', 'ilike', 'Cuscatlán')]"/>
                    <filter string="📍 La Libertad" name="dept_lalibertad" domain="[('city', 'ilike', 'La Libertad')]"/>
                    <filter string="📍 La Paz" name="dept_lapaz" domain="[('city', 'ilike', 'La Paz')]"/>
                    <filter string="📍 La Unión" name="dept_launion" domain="[('city', 'ilike', 'La Unión')]"/>
                    <filter string="📍 Morazán" name="dept_morazan" domain="[('city', 'ilike', 'Morazán')]"/>
                    <filter string="📍 San Miguel" name="dept_sanmiguel" domain="[('city', 'ilike', 'San Miguel')]"/>
                    <filter string="📍 San Salvador" name="dept_sansalvador" domain="[('city', 'ilike', 'San Salvador')]"/>
                    <filter string="📍 San Vicente" name="dept_sanvicente" domain="[('city', 'ilike', 'San Vicente')]"/>
                    <filter string="📍 Santa Ana" name="dept_santaana" domain="[('city', 'ilike', 'Santa Ana')]"/>
                    <filter string="📍 Sonsonate" name="dept_sonsonate" domain="[('city', 'ilike', 'Sonsonate')]"/>
                    <filter string="📍 Usulután" name="dept_usulutan" domain="[('city', 'ilike', 'Usulután')]"/>
                    <separator/>
                    <filter string="Cumpleaños Hoy" name="birthday_today" domain="[('is_birthday_today', '=', True)]"/>

                    <!-- Opción de agrupación -->
                    <group expand="0" string="Agrupar Por">
                        <filter string="Ciudad / Distrito" name="group_by_city" context="{'group_by': 'city'}"/>
                        <filter string="Mes de Cumpleaños" name="group_by_birthday_month" context="{'group_by': 'mr_birthday_month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Inherit res.partner form to add birthday -->
        <record id="view_partner_form_inherit_miss_rose" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.miss.rose</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='category_id']" position="before">
                    <label for="mr_birthday_day" string="Cumpleaños"/>
                    <div class="o_row">
                        <field name="mr_birthday_day" placeholder="Día" style="width: 50px;"/>
                        <span> de </span>
                        <field name="mr_birthday_month" placeholder="Mes"/>
                    </div>
                    <label for="mr_maps_url" string="Dirección Maps"/>
                    <div class="o_row">
                        <field name="mr_maps_url" widget="url" placeholder="https://maps.app.goo.gl/..."/>
                    </div>
                </xpath>
            </field>
        </record>

        <!-- ======================= -->
        <!-- CUMPLEAÑOS VIEWS        -->
        <!-- ======================= -->
        
        <record id="view_miss_rose_birthday_list" model="ir.ui.view">
            <field name="name">miss.rose.birthday.tree</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <list string="Cumpleaños Miss Rose" create="0" edit="0" delete="0">
                    <field name="name" string="Cliente" />
                    <field name="mobile" string="Celular"/>
                    <button name="action_send_whatsapp_birthday" type="object" icon="fa-whatsapp" title="WhatsApp"/>
                    <field name="email" string="Correo" optional="show"/>
                    <button name="action_send_email_birthday" type="object" icon="fa-envelope" title="Enviar Correo"/>
                    <field name="city" string="Ciudad / Depto."/>
                    <field name="mr_birthday_display" string="Fecha de Cumpleaños" />
                    <field name="mr_birthday_month" column_invisible="True"/>
                </list>
            </field>
        </record>

        <record id="action_miss_rose_birthdays" model="ir.actions.act_window">
            <field name="name">Cumpleaños de Clientes</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_miss_rose_birthday_list"/>
            <field name="domain">[('category_id.name', 'ilike', 'MISS ROSE')]</field>
            <field name="search_view_id" ref="view_missrose_analitica_modulo_search"/>
        </record>

        <!-- ======================= -->
        <!-- PRONÓSTICOS VIEWS       -->
        <!-- ======================= -->
        
        <!-- Tree View para Pronósticos -->
        <record id="view_miss_rose_forecast_list" model="ir.ui.view">
            <field name="name">miss.rose.forecast.tree</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <list string="Pronósticos Miss Rose" create="0" edit="0" delete="0">
                    <field name="mr_currency_id" column_invisible="True"/>
                    <field name="name" string="Cliente" />
                    <field name="city" string="Ciudad / Depto." optional="show" />
                    <field name="mr_last_purchase_date" string="Última Compra" optional="hide"/>
                    <field name="mr_avg_days_between" string="Compra cada (Días)" />
                    <field name="mr_days_since_purchase" string="Días sin Comprar" />
                    <field name="mr_expected_ticket" string="Ticket Esperado" />
                    <field name="mr_forecast_probability" string="Probabilidad" />
                    <field name="mr_monthly_forecast" string="Proyección ($)" />
                </list>
            </field>
        </record>

        <!-- Gráfica de Ventas Mensuales (Facturas) -->
        <record id="view_miss_rose_sales_graph" model="ir.ui.view">
            <field name="name">miss.rose.sales.graph</field>
            <field name="model">account.move</field>
            <field name="arch" type="xml">
                <graph string="Ventas Mensuales" type="bar" sample="1">
                    <field name="invoice_date" interval="month"/>
                    <field name="amount_untaxed_signed" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Tabla Pivote de Ventas Mensuales -->
        <record id="view_miss_rose_sales_pivot" model="ir.ui.view">
            <field name="name">miss.rose.sales.pivot</field>
            <field name="model">account.move</field>
            <field name="arch" type="xml">
                <pivot string="Análisis de Ventas" sample="1">
                    <field name="partner_id" type="row"/>
                    <field name="invoice_date" interval="month" type="col"/>
                    <field name="amount_untaxed_signed" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- Graph View para Pronósticos -->
        <record id="view_miss_rose_forecast_graph" model="ir.ui.view">
            <field name="name">miss.rose.forecast.graph</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <graph string="Pronóstico de Ingresos" type="bar" sample="1">
                    <field name="city"/>
                    <field name="mr_monthly_forecast" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Pivot View para Pronósticos -->
        <record id="view_miss_rose_forecast_pivot" model="ir.ui.view">
            <field name="name">miss.rose.forecast.pivot</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <pivot string="Análisis de Pronósticos" sample="1">
                    <field name="city" type="row"/>
                    <field name="mr_monthly_forecast" type="measure"/>
                    <field name="mr_forecast_probability" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- Acciones para el Tablero (Solo vistas individuales) -->
        <record id="action_miss_rose_board_graph" model="ir.actions.act_window">
            <field name="name">Ventas Mensuales</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">graph</field>
            <field name="view_id" ref="view_miss_rose_sales_graph"/>
            <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted'), ('partner_id.category_id.name', 'ilike', 'MISS ROSE')]</field>
        </record>

        <record id="action_miss_rose_board_pivot" model="ir.actions.act_window">
            <field name="name">Análisis de Ventas por Cliente</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">pivot</field>
            <field name="view_id" ref="view_miss_rose_sales_pivot"/>
            <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted'), ('partner_id.category_id.name', 'ilike', 'MISS ROSE')]</field>
        </record>

        <!-- Vista Kanban para KPIs -->
        <record id="view_miss_rose_kpi_kanban" model="ir.ui.view">
            <field name="name">miss.rose.kpi.kanban</field>
            <field name="model">miss.rose.kpi</field>
            <field name="arch" type="xml">
                <kanban create="0" edit="0" class="o_kanban_dashboard">
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click w-100 p-3" style="display:flex; justify-content:space-between; flex-wrap:wrap; border:none; box-shadow:none;">
                                <div class="card p-3 m-1 flex-grow-1" style="background:#f8f9fa; border-radius:10px; min-width:150px; text-align:center;">
                                    <div class="text-muted fw-bold">Total de Ventas</div>
                                    <h2 class="text-primary mt-2"><field name="total_sales" widget="monetary" options="{'currency_field': 'currency_id'}"/></h2>
                                </div>
                                <div class="card p-3 m-1 flex-grow-1" style="background:#f8f9fa; border-radius:10px; min-width:150px; text-align:center;">
                                    <div class="text-muted fw-bold">Facturas Totales</div>
                                    <h2 class="text-info mt-2"><field name="total_orders"/></h2>
                                </div>
                                <div class="card p-3 m-1 flex-grow-1" style="background:#f8f9fa; border-radius:10px; min-width:150px; text-align:center;">
                                    <div class="text-muted fw-bold">Clientes Únicos</div>
                                    <h2 class="text-success mt-2"><field name="total_customers"/></h2>
                                </div>
                                <div class="card p-3 m-1 flex-grow-1" style="background:#f8f9fa; border-radius:10px; min-width:150px; text-align:center;">
                                    <div class="text-muted fw-bold">Gasto Promedio</div>
                                    <h2 class="text-warning mt-2"><field name="average_ticket" widget="monetary" options="{'currency_field': 'currency_id'}"/></h2>
                                </div>
                                <div class="w-100 mt-3 d-flex justify-content-between" style="gap:10px;">
                                    <div class="card p-3 flex-grow-1" style="background:#e3f2fd; border-radius:10px; min-width:150px; text-align:center;">
                                        <div class="text-muted fw-bold">Pronóstico Conservador</div>
                                        <h3 class="text-primary mt-2"><field name="forecast_conservative" widget="monetary" options="{'currency_field': 'currency_id'}"/></h3>
                                    </div>
                                    <div class="card p-3 flex-grow-1 shadow" style="background:#e8f5e9; border-radius:10px; min-width:150px; text-align:center; border:2px solid #4caf50;">
                                        <div class="text-muted fw-bold">Pronóstico Esperado</div>
                                        <h2 class="text-success mt-2"><field name="forecast_expected" widget="monetary" options="{'currency_field': 'currency_id'}"/></h2>
                                    </div>
                                    <div class="card p-3 flex-grow-1" style="background:#fff3e0; border-radius:10px; min-width:150px; text-align:center;">
                                        <div class="text-muted fw-bold">Pronóstico Optimista</div>
                                        <h3 class="text-warning mt-2"><field name="forecast_optimistic" widget="monetary" options="{'currency_field': 'currency_id'}"/></h3>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="action_miss_rose_board_kpi" model="ir.actions.act_window">
            <field name="name">Indicadores Generales</field>
            <field name="res_model">miss.rose.kpi</field>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="view_miss_rose_kpi_kanban"/>
        </record>

        <!-- Vista del Tablero Principal (Board) -->
        <record id="view_miss_rose_dashboard_board" model="ir.ui.view">
            <field name="name">miss.rose.dashboard.board</field>
            <field name="model">board.board</field>
            <field name="arch" type="xml">
                <form string="Tablero de Estadísticas Miss Rose">
                    <board style="1-1">
                        <column>
                            <action name="%(missrose_analitica_modulo.action_miss_rose_board_kpi)d" string="Resumen Global (KPIs)"/>
                            <action name="%(missrose_analitica_modulo.action_miss_rose_board_graph)d" string="Ventas Mensuales"/>
                        </column>
                        <column>
                            <action name="%(missrose_analitica_modulo.action_miss_rose_board_pivot)d" string="Ranking de Clientes"/>
                        </column>
                    </board>
                </form>
            </field>
        </record>
        <!-- Custom Inventory Views for Miss Rose -->
        <record id="view_miss_rose_product_kanban" model="ir.ui.view">
            <field name="name">miss.rose.product.kanban</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_kanban_view"/>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <xpath expr="//kanban" position="inside">
                    <field name="qty_available"/>
                    <field name="uom_id"/>
                </xpath>
                <xpath expr="//div[hasclass('mb-1')]" position="after">
                    <div class="mt-2 mb-2">
                        <span t-if="record.qty_available.raw_value &lt;= 10" class="badge text-bg-danger" style="font-size: 12px; padding: 5px;">
                            Stock: <field name="qty_available"/> <field name="uom_id"/>
                        </span>
                        <span t-if="record.qty_available.raw_value &gt; 10 and record.qty_available.raw_value &lt;= 30" class="badge text-bg-warning" style="font-size: 12px; padding: 5px;">
                            Stock: <field name="qty_available"/> <field name="uom_id"/>
                        </span>
                        <span t-if="record.qty_available.raw_value &gt; 30" class="badge text-bg-success" style="font-size: 12px; padding: 5px;">
                            Stock: <field name="qty_available"/> <field name="uom_id"/>
                        </span>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="view_miss_rose_product_list" model="ir.ui.view">
            <field name="name">miss.rose.product.tree</field>
            <field name="model">product.template</field>
            <field name="arch" type="xml">
                <list string="Inventario Miss Rose">
                    <field name="name" string="Producto"/>
                    <field name="categ_id" string="Categoría" optional="show"/>
                    <field name="list_price" string="Precio" />
                    <field name="currency_id" column_invisible="True"/>
                    <field name="qty_available" string="Stock" />
                    <field name="uom_id" string="UdM" groups="uom.group_uom"/>
                </list>
            </field>
        </record>

        <record id="view_miss_rose_product_search" model="ir.ui.view">
            <field name="name">miss.rose.product.search</field>
            <field name="model">product.template</field>
            <field name="arch" type="xml">
                <search string="Filtros de Inventario Miss Rose">
                    <field name="name" string="Producto"/>
                    <field name="categ_id" string="Categoría"/>
                    
                    <filter string="Agotado (0)" name="filter_out_of_stock" domain="[('qty_available', '&lt;=', 0)]"/>
                    <filter string="Pocas Existencias (1-10)" name="filter_low_stock" domain="[('qty_available', '&gt;', 0), ('qty_available', '&lt;=', 10)]"/>
                    <filter string="Existencias Medias (11-30)" name="filter_medium_stock" domain="[('qty_available', '&gt;', 10), ('qty_available', '&lt;=', 30)]"/>
                    <filter string="Alto Stock (+30)" name="filter_full_stock" domain="[('qty_available', '&gt;', 30)]"/>
                    
                    <group expand="0" string="Agrupar Por">
                        <filter string="Categoría" name="group_by_category" context="{'group_by': 'categ_id'}"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>
