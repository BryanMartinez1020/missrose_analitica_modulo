<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Ocultar globalmente los grupos de dashboard Logística y Sitio Web -->
        <record id="rule_hide_logistics_website_groups" model="ir.rule">
            <field name="name">Ocultar Grupos de Dashboard Logistica y Sitio Web</field>
            <field name="model_id" ref="spreadsheet_dashboard.model_spreadsheet_dashboard_group"/>
            <field name="domain_force">[('name', 'not ilike', 'Logístic'), ('name', 'not ilike', 'Logistic'), ('name', 'not ilike', 'Sitio Web'), ('name', 'not ilike', 'Website')]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- Ocultar globalmente los dashboards dentro de Logística y Sitio Web -->
        <record id="rule_hide_logistics_website_dashboards" model="ir.rule">
            <field name="name">Ocultar Dashboards de Logistica y Sitio Web</field>
            <field name="model_id" ref="spreadsheet_dashboard.model_spreadsheet_dashboard"/>
            <field name="domain_force">[('dashboard_group_id.name', 'not ilike', 'Logístic'), ('dashboard_group_id.name', 'not ilike', 'Logistic'), ('dashboard_group_id.name', 'not ilike', 'Sitio Web'), ('dashboard_group_id.name', 'not ilike', 'Website')]</field>
        </record>
    </data>
    <data>
        <record id="module_category_miss_rose" model="ir.module.category">
            <field name="name">Miss Rose Analytics</field>
        </record>
        <record id="group_miss_rose_user" model="res.groups">
            <field name="name">Usuario Miss Rose Analytics</field>
            <field name="category_id" ref="module_category_miss_rose"/>
            <field name="comment">El usuario tendrá acceso al módulo de Miss Rose Analytics.</field>
        </record>
    </data>
</odoo>
